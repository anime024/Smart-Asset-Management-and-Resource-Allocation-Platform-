<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form method="POST">

    <input name="name" placeholder="Name">

    <input name="category" placeholder="Category">

    <textarea
        name="description"
        placeholder="description"
    ></textarea>

    <input
        type="number"
        name="totalQuantity"
        placeholder="totalQuantity"
    >

    <input
        type="number"
        name="availableQuantity"
        placeholder="availableQuantity"
    >

    <select name="status">

        <option>
            Available
        </option>

        <option>
            Limited
        </option>

        <option>
            Out of Stock
        </option>

    </select>

    <button>
        Create
    </button>

</form>
</body>
</html>