<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        *{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f5f6fa;
}

.container{
    max-width:1400px;
    margin:30px auto;
    padding:20px;
}

.page-title{
    color:#273c75;
    margin-bottom:25px;
}

/* Stats Cards */

.cards{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
    margin-bottom:30px;
}

.card{
    background:white;
    padding:25px;
    border-radius:12px;
    box-shadow:0 2px 10px rgba(0,0,0,.08);
    transition:.3s;
}

.card:hover{
    transform:translateY(-3px);
}

.card h3{
    color:#666;
    font-size:15px;
    margin-bottom:10px;
}

.card h2{
    color:#273c75;
    font-size:32px;
}

/* Charts */

.charts{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
    margin-bottom:30px;
}

.chart-card{
    background:white;
    padding:25px;
    border-radius:12px;
    box-shadow:0 2px 10px rgba(0,0,0,.08);
}

.chart-card h2{
    margin-bottom:20px;
    color:#273c75;
}

/* Sections */

.section{
    margin-top:30px;
}

.section h2{
    color:#273c75;
    margin-bottom:15px;
}

/* Tables */

.table-card{
    background:white;
    border-radius:12px;
    overflow:hidden;
    box-shadow:0 2px 10px rgba(0,0,0,.08);
}

table{
    width:100%;
    border-collapse:collapse;
}

th{
    background:#273c75;
    color:white;
    padding:14px;
    text-align:left;
}

td{
    padding:14px;
    border-bottom:1px solid #ddd;
}

tr:hover{
    background:#f8f9fa;
}

/* Status badges */

.badge{
    padding:6px 12px;
    border-radius:20px;
    font-size:13px;
    font-weight:bold;
}

.pending{
    background:#fff3cd;
    color:#856404;
}

.approved{
    background:#d4edda;
    color:#155724;
}

.rejected{
    background:#f8d7da;
    color:#721c24;
}

.issued{
    background:#cce5ff;
    color:#004085;
}

.returned{
    background:#d1ecf1;
    color:#0c5460;
}

/* Responsive */

@media(max-width:900px){

    .charts{
        grid-template-columns:1fr;
    }
}
    </style>
</head>

<body>

    <% if(user){ %>
        <%- include("../partials/navbar") %>
    <% } %>

    <div class="container">
    <h1>Admin Dashboard</h1>


    <div class="cards">

        <div class="card">
            <h3>Total Assets</h3>
            <h2><%= totalAssets %></h2>
        </div>

        <div class="card">
            <h3>Total Users</h3>
            <h2><%= totalUsers %></h2>
        </div>

        <div class="card">
            <h3>Pending Requests</h3>
            <h2><%= pendingRequests %></h2>
        </div>

        <div class="card">
            <h3>Active Allocations</h3>
            <h2><%= activeAllocations %></h2>
        </div>

    </div>

    <!-- Charts -->

    <div class="charts">

        <div class="chart-card">
            <h2>Most Used Assets</h2>
            <canvas id="assetChart"></canvas>
        </div>

        <div class="chart-card">
            <h2>Asset Categories</h2>
            <canvas id="categoryChart"></canvas>
        </div>

    </div>

    <!-- Overdue Assets -->

</div>

    <!-- Most Used Assets Chart -->

    <script>

        const assetLabels = [
            <% mostUsedAssets.forEach(asset=>{ %>
                "<%= asset._id.name %>",
            <% }) %>
        ];

        const assetCounts = [
            <% mostUsedAssets.forEach(asset=>{ %>
                <%= asset.count %>,
            <% }) %>
        ];

        new Chart(
            document.getElementById("assetChart"),
            {
                type:"bar",
                data:{
                    labels:assetLabels,
                    datasets:[{
                        label:"Usage Count",
                        data:assetCounts
                    }]
                }
            }
        );

    </script>

    <!-- Category Pie Chart -->

    <script>

        new Chart(
            document.getElementById("categoryChart"),
            {
                type:"pie",
                data:{
                    labels:[
                        <% categoryData.forEach(c=>{ %>
                            "<%= c._id %>",
                        <% }) %>
                    ],
                    datasets:[{
                        data:[
                            <% categoryData.forEach(c=>{ %>
                                <%= c.count %>,
                            <% }) %>
                        ]
                    }]
                }
            }
        );

    </script>

</body>
</html>