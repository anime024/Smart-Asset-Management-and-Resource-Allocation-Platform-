<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Dashboard</title>
</head>
<body>
    <% if (user) { %>
     
        <%- include("../partials/navbar") %>    
    <% } %>
   <h1>Hii <%= user.name %></h1>
    
    <h2>My Requests</h2>

<table>

<tr>
<th>Asset</th>
<th>Quantity</th>
<th>Status</th>
</tr>

<% bookings.forEach(booking=>{ %>

<tr>

<td>
<%= booking.asset.name %>
</td>

<td>
<%= booking.quantity %>
</td>

<td>
<%= booking.status %>
</td>

</tr>

<% }) %>

</table>

</body>
</html>